{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keycrm-telegram-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keycrm-bot-db",
      "database_id": "7e6c4018-da82-4309-bc58-49118c9dd882"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "TIMEZONE": "Europe/Kyiv",
    "CURRENCY": "UAH",
    "COMPANY_NAME": "KeyCRM"
  },
  "previews": {
    "vars": {
      "TIMEZONE": "Europe/Kyiv",
      "CURRENCY": "UAH",
      "COMPANY_NAME": "KeyCRM"
    }
  }
}
